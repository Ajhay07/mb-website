{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/_next/static/immutable/chunks/:path*",
      "destination": "/assets/chunks/:path*"
    },
    {
      "source": "/_next/static/immutable/media/:path*",
      "destination": "/assets/media/:path*"
    },
    {
      "source": "/_next/static/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/static/immutable/chunks/:path*",
      "destination": "/assets/chunks/:path*"
    },
    {
      "source": "/static/immutable/media/:path*",
      "destination": "/assets/media/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
